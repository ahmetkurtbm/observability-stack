# Copy to .env and fill in real values before running `docker compose up -d`

# Grafana admin login
GRAFANA_ADMIN_PASSWORD=change-me-to-a-strong-password

# Domains (must point to this VPS's IP via DNS A records before starting Caddy,
# otherwise Let's Encrypt certificate issuance will fail)
ACME_EMAIL=you@example.com
GRAFANA_DOMAIN=grafana.yourdomain.com
OTEL_DOMAIN=otel.yourdomain.com
OTEL_GRPC_DOMAIN=otel-grpc.yourdomain.com
